{
  "modName": "AozoraFavorites",
  "displayName": "$AOZORA_MCM_TITLE",
  "minMcmVersion": 1,
  "pluginRequirements": ["AozoraFavorites.esp"],
  "content": [
    { "type": "section", "text": "$AOZORA_MCM_SECTION_APPEARANCE" },
    {
      "id": "bMascotEnabled:General",
      "type": "switcher",
      "text": "$AOZORA_MCM_MASCOT_TEXT",
      "help": "$AOZORA_MCM_MASCOT_HELP",
      "valueOptions": { "sourceType": "ModSettingBool", "default": true }
    },
    {
      "id": "iThemeColorMode:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_THEME_MODE_TEXT",
      "help": "$AOZORA_MCM_THEME_MODE_HELP",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "default": 0,
        "options": ["$AOZORA_MCM_THEME_MODE_HUD", "$AOZORA_MCM_THEME_MODE_PRESET"]
      }
    },
    {
      "id": "iThemeColorPreset:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_THEME_PRESET_TEXT",
      "help": "$AOZORA_MCM_THEME_PRESET_HELP",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "default": 0,
        "options": [
          "$AOZORA_MCM_PRESET_GREEN", "$AOZORA_MCM_PRESET_AMBER",
          "$AOZORA_MCM_PRESET_ICE", "$AOZORA_MCM_PRESET_RUST",
          "$AOZORA_MCM_PRESET_LAVENDER", "$AOZORA_MCM_PRESET_WHITE"
        ]
      }
    },
    { "type": "section", "text": "$AOZORA_MCM_SECTION_DPAD" },
    {
      "id": "iDPadUpAction:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_DPAD_UP",
      "help": "$AOZORA_MCM_DPAD_HELP",
      "valueOptions": { "sourceType": "ModSettingInt", "default": 1, "options": ["$AOZORA_MCM_NO_ACTION", "$AOZORA_MCM_OPEN_FAVORITES"] }
    },
    {
      "id": "iDPadDownAction:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_DPAD_DOWN",
      "help": "$AOZORA_MCM_DPAD_HELP",
      "valueOptions": { "sourceType": "ModSettingInt", "default": 1, "options": ["$AOZORA_MCM_NO_ACTION", "$AOZORA_MCM_OPEN_FAVORITES"] }
    },
    {
      "id": "iDPadLeftAction:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_DPAD_LEFT",
      "help": "$AOZORA_MCM_DPAD_HELP",
      "valueOptions": { "sourceType": "ModSettingInt", "default": 1, "options": ["$AOZORA_MCM_NO_ACTION", "$AOZORA_MCM_OPEN_FAVORITES"] }
    },
    {
      "id": "iDPadRightAction:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_DPAD_RIGHT",
      "help": "$AOZORA_MCM_DPAD_HELP",
      "valueOptions": { "sourceType": "ModSettingInt", "default": 1, "options": ["$AOZORA_MCM_NO_ACTION", "$AOZORA_MCM_OPEN_FAVORITES"] }
    },
    { "type": "section", "text": "$AOZORA_MCM_SECTION_LIST" },
    {
      "id": "bShowItemInnerName:General",
      "type": "switcher",
      "text": "$AOZORA_MCM_SUFFIX_TEXT",
      "help": "$AOZORA_MCM_SUFFIX_HELP",
      "valueOptions": { "sourceType": "ModSettingBool", "default": false }
    },
    {
      "id": "iAllSortMode:General",
      "type": "dropdown",
      "text": "$AOZORA_MCM_SORT_TEXT",
      "help": "$AOZORA_MCM_SORT_HELP",
      "valueOptions": { "sourceType": "ModSettingInt", "default": 0, "options": ["$AOZORA_MCM_SORT_NAME", "$AOZORA_MCM_SORT_USAGE"] }
    },
    { "type": "section", "text": "$AOZORA_MCM_SECTION_BEHAVIOR" },
    {
      "id": "fSlowMotionScale:General",
      "type": "slider",
      "text": "$AOZORA_MCM_TIMESCALE_TEXT",
      "help": "$AOZORA_MCM_TIMESCALE_HELP",
      "valueOptions": { "sourceType": "ModSettingFloat", "default": 0, "min": 0, "max": 1, "step": 0.5 }
    }
  ]
}
